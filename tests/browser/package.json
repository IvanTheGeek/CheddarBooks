{
  "name": "cheddarbooks-browser-tests",
  "private": true,
  "scripts": {
    "test": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:headed": "env -u FORCE_COLOR -u NO_COLOR playwright test --headed",
    "test:ui": "env -u FORCE_COLOR -u NO_COLOR playwright test --ui",
    "install:browsers": "playwright install chromium",
    "show-report": "env -u FORCE_COLOR -u NO_COLOR playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "typescript": "6.0.2"
  }
}
